# Supabase
# 開発初期: ローカル（next dev）も本番プロジェクトを見る。
#   `.env.development.local` に本番 URL / キーを置く（.env.production.local からコピー。git 管理外）。
# リリース後にローカルDBへ戻す:
#   `.env.development.local` の4変数を下のローカル値に戻すか、そのファイルを削除する。
#   Vercel と `.env.production.local` はいじらない（クラウド本番は別DBのまま）。
# ローカル: API http://127.0.0.1:56421 / PostgreSQL 127.0.0.1:56422 / Studio http://127.0.0.1:56423
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_ID=dx-sensor
# 本番接続先は .env.production.local（git 管理外）。Vercel は Dashboard / vercel env で設定。

# ANPR (Plate Recognizer)
PLATE_RECOGNIZER_API_KEY=
PLATE_RECOGNIZER_MODE=snapshot   # snapshot | stream

# Cron / internal job auth (used by Vercel Cron -> /api/cron/*)
CRON_SECRET=

# Vision API keys (画像解析画面 /api/analyze)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 消費概算コストのUSD→JPY換算（未設定時は150）
# COST_USD_JPY=150
# 解析送出前の長辺上限（px）。Storageの原寸は変更しない
# VISION_MAX_EDGE_PX=1568
# VISION_ANPR_MAX_EDGE_PX=2048

# Camera defaults (per-camera config actually lives in DB `cameras` table;
# these are only fallback/dev values for local testing against a single camera)
DEV_CAMERA_VENDOR=tapo           # tapo | reolink
DEV_CAMERA_HOST=
DEV_CAMERA_PORT=2020
DEV_CAMERA_USER=
DEV_CAMERA_PASS=

# LINE連携（LINE公式アカウント + LIFF）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINEログインチャネルの数値チャネルID(IDトークンのaud検証用)。
#   NEXT_PUBLIC_LIFF_ID(LIFF ID, 形式:「チャネルID-サフィックス」)とは別物。混同注意。
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# LINE友だち招待機能（メール送信）
RESEND_API_KEY=
EMAIL_FROM=
