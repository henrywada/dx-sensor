# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ANPR (Plate Recognizer)
PLATE_RECOGNIZER_API_KEY=
PLATE_RECOGNIZER_MODE=snapshot   # snapshot | stream

# Cron / internal job auth (used by Vercel Cron -> /api/cron/*)
CRON_SECRET=

# Camera defaults (per-camera config actually lives in DB `cameras` table;
# these are only fallback/dev values for local testing against a single camera)
DEV_CAMERA_VENDOR=tapo           # tapo | reolink
DEV_CAMERA_HOST=
DEV_CAMERA_PORT=2020
DEV_CAMERA_USER=
DEV_CAMERA_PASS=
